# Vite solo expone variables que empiezan por VITE_
# Desarrollo: ruta relativa → proxy en vite.config (sin CORS). Backend en :8000.
VITE_API_BASE_URL=/api/
# Producción o si el backend ya tiene CORS bien configurado:
# VITE_API_BASE_URL=http://localhost:8000/
# VITE_API_BASE_URL=https://dev-friend-back-ts.onrender.com/
