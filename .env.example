# Obligatorio: sin esto las peticiones van al puerto de Vite (ej. 5173) y dan 404.
# Local con proxy (recomendado si el backend no envía cabeceras CORS):
# VITE_API_BASE_URL=/api/
# Misma máquina con CORS ya configurado en el backend:
# VITE_API_BASE_URL=http://localhost:8000/
VITE_API_BASE_URL=/api/
